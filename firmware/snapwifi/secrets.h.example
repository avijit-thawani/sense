// Copy to secrets.h (gitignored) and fill in. The board only sees 2.4 GHz networks,
// and names are case-sensitive. It joins whichever of the two is stronger.
#define WIFI_SSID "home-wifi-name"
#define WIFI_PASS "home-wifi-password"
#define WIFI_SSID2 "phone-hotspot-name"
#define WIFI_PASS2 "phone-hotspot-password"
